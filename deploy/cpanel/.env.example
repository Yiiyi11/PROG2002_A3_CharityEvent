# ---------------------------------------------------------------------------
# Charity Events API - environment configuration for cPanel
#
# IMPORTANT: rename this file to ".env" after uploading (dot-files are often
# hidden in cPanel File Manager - enable "Show Hidden Files" in Settings).
# The .env file must sit in the same folder as app.js.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# On cPanel you cannot use "root". Every database and user name is prefixed
# with your cPanel account name, so replace "cpuser" with your own account.
# You can read the exact names in cPanel -> MySQL Databases.
#
#   Database : cpuser_charity
#   User     : cpuser_charityadm
#
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpuser_charityadm
DB_PASSWORD=PUT_THE_DATABASE_USER_PASSWORD_HERE
DB_NAME=cpuser_charity

# --- Express / Passenger --------------------------------------------------
# Passenger assigns the port itself, so this value is only used when you run
# `node app.js` manually over SSH. Leave it as 3000.
PORT=3000

# Restrict which origins may call the API.
# "*" is the simplest option for marking; tighten it to your own domain if you
# want to demonstrate stricter CORS, e.g. https://yourdomain.com
CLIENT_ORIGIN=*
