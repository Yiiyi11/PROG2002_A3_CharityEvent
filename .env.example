# ---------------------------------------------------------------------------
# Charity Events API - environment configuration (Assessment 3)
# Copy this file to `.env` and fill in your own values.
# `.env` is listed in .gitignore so real passwords are never pushed to GitHub.
# ---------------------------------------------------------------------------

# Local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=charityevents_db

# Express server
PORT=3000

# Local client origin allowed by CORS ("*" also works for the public cPanel deployment)
CLIENT_ORIGIN=*
